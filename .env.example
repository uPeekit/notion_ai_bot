# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# Notion (internal integration secret)
NOTION_TOKEN=
NOTION_VERSION=2025-09-03

# LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Benchmark winner on an 8 GB laptop GPU: 91% safe, 2 wrong values in 44 cases.
# qwen3:8b is the faster alternative (~8 s vs ~16 s) at 75% safe, 6 wrong.
LLM_MODEL=mistral-nemo:12b
LLM_TEMPERATURE=0
# 8192 keeps the KV cache small; 16384 pushed a fifth of the model onto the CPU
# and cost ~35% of the speed for no measurable accuracy gain.
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=120
# How long Ollama keeps the model loaded after a message. Reloading costs ~16 s (measured:
# 32 s cold vs 16 s warm). -1 = always loaded (always fast, holds the GPU); 5m = Ollama default.
LLM_KEEP_ALIVE=30m

# Claude (optional): answers first, the local model above is the automatic fallback.
# An API key from platform.claude.com, not a claude.ai subscription (see README).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_TIMEOUT_S=30
# false: never send anything to Claude, even with a key set
LLM_CLOUD=true
# Web research ("найди ... и запиши в ...") — needs the key above.
RESEARCH_MODEL=claude-haiku-4-5
RESEARCH_MAX_SEARCHES=3
# Multi-step goals ("организуй...", a list of books -> one row each) — needs the key above.
PLAN_MODEL=claude-haiku-4-5

# Speech
WHISPER_MODEL=large-v3-turbo
# cpu, not auto: the 12B model leaves no VRAM for Whisper on an 8 GB card.
# On a bigger GPU, set this back to auto.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Locale
TIMEZONE=Europe/Tallinn
LOCALE=ru

# Storage
DB_PATH=data/bot.sqlite
TARGETS_FILE=data/targets.yaml
SCHEMA_CACHE_TTL_S=60
ITEMS_PER_TARGET=15
ADMIN_UI_PORT=8787

# Policy thresholds (0..1)
POLICY_INTENT_MIN=0.85
POLICY_TARGET_MIN=0.85
POLICY_TARGET_MARGIN=0.10
POLICY_FIELD_MIN=0.75
POLICY_DATE_MIN=0.80

SESSION_TTL_S=900
UNDO_WINDOW_S=300
LOG_LEVEL=INFO
# Rotating log file (5 MB x 5), redacted like the console. Empty = console only.
LOG_FILE=logs/bot.log

# Inbox fallback: auto = save + offer button, button = only on button press, off = disabled
INBOX_MODE=auto
# Notion page/data-source id that overrides the targets.yaml `inbox: true` flag
INBOX_TARGET_ID=
